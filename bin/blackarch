#!/usr/bin/env python3
# blackarch:summary=Blackarch dispatcher (modular)
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, "/opt/blackarch")
from blackarch_modules.blackarch_core import *  # noqa
from blackarch_modules.blackarch_core import main as _core_main

def main(argv):
    # Flatten execute subcommands to top level
    try:
        sys.path.insert(0, "/opt/blackarch/blackarch_modules")
        from blackarch_modules.blackarch_core_execute import main as _exec_main
        from blackarch_modules.blackarch_core_execute import print_help as _exec_help
        _exec_cmds = ["shell","toggle","quickshell","vpn","smartthings","update","update-system",
                      "webapp","work","private","tui","gui","window","brightness",
                      "audio","focus","setup","banner","charger","flatpak-ulaa"]
        if argv and argv[0] in _exec_cmds:
            # The execute module's main() treats every argument as real input,
            # so `blackarch <cmd> --help` would otherwise launch the command
            # instead of documenting it. Print its help table first.
            if any(a in ("--help", "-h") for a in argv[1:]):
                _exec_help()
                return 0
            return _exec_main(argv)
    except Exception:
        pass
    if argv and argv[0] == "--complete":
        try:
            from blackarch_modules.blackarch_core import GROUP_DESCRIPTIONS
            cmds = sorted(GROUP_DESCRIPTIONS)
            # include flattened execute subcommands
            cmds = sorted(set(cmds + ["shell","toggle","quickshell","vpn","smartthings","update","update-system",
                      "webapp","work","private","tui","gui","window","brightness",
                      "audio","focus","setup","banner","charger","flatpak-ulaa"]))
            for k in cmds:
                print(k)
        except Exception:
            pass
        return 0
    import importlib
    n = len(argv)
    m = None
    for n in range(len(argv), 0, -1):
        modname = "blackarch_modules.blackarch_" + "_".join(argv[:n]).replace("-", "_")
        try:
            m = importlib.import_module(modname)
            break
        except Exception:
            m = None
    if m is not None and hasattr(m, "main"):
        rest = argv[n:] if m is not None else argv[1:]
        for call in (lambda: m.main(rest),
                    lambda: m.main(argv),
                    lambda: m.main()):
            try:
                return call()
            except TypeError:
                continue
            except Exception:
                break
    # Fallback for unported commands: resolve the longest bin/blackarch-* prefix
    # and exec it directly so its own shebang picks the interpreter. Joining the
    # whole argv into the filename only worked for bare commands (any flag made
    # the name miss), and forcing `bash` mis-executed Python scripts.
    for count in range(len(argv), 0, -1):
        candidate = os.path.join(
            "/opt/blackarch/bin", "blackarch-" + "-".join(argv[:count])
        )
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            os.execv(candidate, [candidate, *argv[count:]])
    return _core_main(argv)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
