#!/usr/bin/env python3
# blackarch:summary=Blackarch dispatcher (modular)
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, "/opt/blackarch")
from blackarch_modules.blackarch_core import *  # noqa
from blackarch_modules.blackarch_core import main as _core_main

def main(argv):
    # Flatten execute subcommands to top level
    try:
        sys.path.insert(0, "/opt/blackarch/blackarch_modules")
        from blackarch_modules.blackarch_execute_core import main as _exec_main
        _exec_cmds = ["shell","toggle","quickshell","vpn","smartthings","update","update-system",
                      "webapp","work","private","tui","gui","window","brightness",
                      "audio","focus","setup","banner","charger"]
        if argv and argv[0] in _exec_cmds:
            return _exec_main(argv)
    except Exception:
        pass
    if argv and argv[0] == "--complete":
        try:
            from blackarch_modules.blackarch_core import GROUP_DESCRIPTIONS
            cmds = sorted(GROUP_DESCRIPTIONS)
            # include flattened execute subcommands
            cmds = sorted(set(cmds + ["shell","toggle","quickshell","vpn","smartthings","update","update-system",
                      "webapp","work","private","tui","gui","window","brightness",
                      "audio","focus","setup","banner","charger"]))
            for k in cmds:
                print(k)
        except Exception:
            pass
        return 0
    import importlib
    n = len(argv)
    m = None
    for n in range(len(argv), 0, -1):
        modname = "blackarch_modules.blackarch_" + "_".join(argv[:n]).replace("-", "_")
        try:
            m = importlib.import_module(modname)
            break
        except Exception:
            m = None
    if m is not None and hasattr(m, "main"):
        rest = argv[n:] if m is not None else argv[1:]
        for call in (lambda: m.main(rest),
                    lambda: m.main(argv),
                    lambda: m.main()):
            try:
                return call()
            except TypeError:
                continue
            except Exception:
                break
    # Fallback to bash scripts for unported commands
    import subprocess
    bash_name = "blackarch-" + "-".join(argv).replace("_","-")
    # try exact
    candidate = os.path.join("/opt/blackarch/bin", bash_name)
    if os.path.isfile(candidate):
        rc = subprocess.call(["bash", candidate, *argv[1:]])
        print(f"[done] {bash_name}")
        return rc
    return _core_main(argv)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
