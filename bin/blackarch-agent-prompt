#!/bin/bash

# blackarch:summary=Launch the default coding agent with a prompt
# blackarch:args=[--inline] <prompt...>
# blackarch:examples=blackarch agent prompt "Review this project"

# Prompts live here rather than on `blackarch agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: blackarch agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec blackarch-agent "${inline[@]}" --prompt "$*"
