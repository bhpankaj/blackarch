#!/bin/bash

# blackarch:summary=Apply Blackarch hardware-specific packages and system configuration
# blackarch:group=apply
# blackarch:requires-sudo=true
# blackarch:examples=blackarch apply hardware --install-user dhh
# blackarch:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: blackarch apply hardware --install-user USER
       blackarch apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by blackarch-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/blackarch/provisioning/groups.
USAGE
}

install_user="${BLACKARCH_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: blackarch-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export BLACKARCH_INSTALL_USER="$install_user"
export BLACKARCH_PATH="${BLACKARCH_PATH:-/usr/share/blackarch}"
export BLACKARCH_INSTALL="${BLACKARCH_INSTALL:-$BLACKARCH_PATH/install}"
export BLACKARCH_INSTALL_LOG_FILE="${BLACKARCH_INSTALL_LOG_FILE:-/var/log/blackarch-install.log}"
export PATH="$BLACKARCH_PATH/bin:$PATH"

source "$BLACKARCH_INSTALL/helpers/logging.sh"
source "$BLACKARCH_INSTALL/hardware/all.sh"
