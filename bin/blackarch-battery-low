#!/bin/bash

# blackarch:summary=Send the low battery warning notification and run battery-low hooks.
# blackarch:args=<percentage>
# blackarch:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: blackarch-battery-low <percentage>" >&2
  exit 1
fi

level=$1

blackarch-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
blackarch-hook battery-low "$level"
