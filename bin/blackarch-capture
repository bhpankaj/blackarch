#!/usr/bin/env python3
# blackarch:summary=Capture dispatcher (screenshot, text, screenrecording, webcam, region, qr)
# blackarch:group=capture
import os, subprocess, sys

SUBCOMMANDS = {
    "screenshot": "blackarch-capture-screenshot",
    "text": "blackarch-capture-text",
    "screenrecording": "blackarch-capture-screenrecording",
    "screenrecord": "blackarch-capture-screenrecording",
    "stop": "blackarch-capture-screenrecording",
    "webcam-list": "blackarch-capture-webcam-list",
    "webcam-resize": "blackarch-capture-webcam-resize",
    "region": "blackarch-capture-region",
    "qr": "blackarch-capture-qr",
    "screenrecording-with-webcam": "blackarch-capture-screenrecording-with-webcam",
}

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("Usage: blackarch capture <subcommand> [args...]")
        print("Subcommands:", ", ".join(sorted(SUBCOMMANDS)))
        return 0
    if argv[0] == "--complete":
        for c in sorted(set(SUBCOMMANDS)):
            print(c)
        return 0
    sub = argv[0]
    binary = SUBCOMMANDS.get(sub)
    if not binary:
        print(f"Unknown subcommand: {sub}", file=sys.stderr)
        return 2
    path = os.path.join("/opt/blackarch/bin", binary)
    extra = ["--stop-recording"] if sub == "stop" else []
    return subprocess.call([path, *extra, *argv[1:]])

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
