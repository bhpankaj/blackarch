#!/bin/bash

# blackarch:summary=Take a screenshot
# blackarch:group=capture
# blackarch:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# blackarch:examples=blackarch screenshot | blackarch capture screenshot region
# blackarch:aliases=blackarch screenshot

if [[ -n ${BLACKARCH_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$BLACKARCH_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"



































































































