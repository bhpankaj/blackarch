#!/usr/bin/env python3
# blackarch:summary=Resize the active webcam recording overlay
# blackarch:group=capture
# blackarch:args=<smaller|larger|reset|small|medium|large>

import json, os, re, subprocess, sys

MARGIN = 40
REGION_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "blackarch-screenrecord-region")

def hyprctl_json(args):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True)
    try:
        return json.loads(out.stdout)
    except Exception:
        return None

def hypr_dispatch(lua, *fallback):
    subprocess.run(["hyprctl", "dispatch", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # fallback best-effort
    subprocess.run(["hyprctl", "dispatch", *fallback], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action not in ("smaller", "larger", "reset", "small", "medium", "large"):
        print("Usage: blackarch-capture-webcam-resize <smaller|larger|reset|small|medium|large>", file=sys.stderr)
        return 1

    clients = hyprctl_json(["clients"]) or []
    client = None
    for c in clients:
        if c.get("title") == "WebcamOverlay":
            client = c
            break
    if not client:
        return 0
    address = client.get("address")
    size = client.get("size", [0, 0])
    current_width, current_height = size[0], size[1]
    monitor_id = client.get("monitor")
    if not (address and isinstance(current_width, int) and current_width > 0 and isinstance(current_height, int) and current_height > 0):
        return 0

    monitors = hyprctl_json(["monitors"]) or []
    monitor = None
    for m in monitors:
        if m.get("id") == monitor_id:
            monitor = m
            break
    if not monitor:
        return 0
    rotated = (monitor.get("transform", 0) % 2 == 1)
    mx = monitor.get("x", 0)
    my = monitor.get("y", 0)
    mw = (monitor.get("height") if rotated else monitor.get("width")) // monitor.get("scale", 1)
    mh = (monitor.get("width") if rotated else monitor.get("height")) // monitor.get("scale", 1)

    anchor_x, anchor_y, anchor_width, anchor_height = mx, my, mw, mh
    if os.path.isfile(REGION_FILE):
        try:
            region = open(REGION_FILE).read().strip()
            m2 = re.match(r"^(\d+)x(\d+)\+(-?\d+)\+(-?\d+)$", region)
            if m2:
                anchor_width = int(m2.group(1))
                anchor_height = int(m2.group(2))
                anchor_x = int(m2.group(3))
                anchor_y = int(m2.group(4))
        except Exception:
            pass

    scale_height = anchor_height
    available_width = anchor_width - 2 * MARGIN
    if available_width > 0 and scale_height * 3 // 10 > available_width:
        scale_height = available_width * 10 // 3

    small_height = (scale_height * 9 + 25) // 50
    small_width = (small_height * 8 + 4) // 9
    medium_height = (scale_height + 2) // 4
    medium_width = (medium_height * 8 + 4) // 9
    large_height = (scale_height * 27 + 40) // 80
    large_width = (large_height * 8 + 4) // 9

    target_width, target_height = current_width, current_height
    if action == "small":
        target_width, target_height = small_width, small_height
    elif action in ("medium", "reset"):
        target_width, target_height = medium_width, medium_height
    elif action == "large":
        target_width, target_height = large_width, large_height
    elif action == "smaller":
        if large_width < current_width:
            target_width, target_height = large_width, large_height
        elif medium_width < current_width:
            target_width, target_height = medium_width, medium_height
        elif small_width < current_width:
            target_width, target_height = small_width, small_height
    elif action == "larger":
        if small_width > current_width:
            target_width, target_height = small_width, small_height
        elif medium_width > current_width:
            target_width, target_height = medium_width, medium_height
        elif large_width > current_width:
            target_width, target_height = large_width, large_height

    target_x = anchor_x + anchor_width - target_width - MARGIN
    target_y = anchor_y + anchor_height - target_height - MARGIN
    if target_x < anchor_x + MARGIN:
        target_x = anchor_x + MARGIN
    if target_y < anchor_y + MARGIN:
        target_y = anchor_y + MARGIN

    window = f"address:{address}"
    hypr_dispatch(f'hl.dsp.window.resize({{ window = "{window}", x = {target_width}, y = {target_height} }})',
                  "resizewindowpixel", f"exact {target_width} {target_height},{window}")
    hypr_dispatch(f'hl.dsp.window.move({{ window = "{window}", x = {target_x}, y = {target_y} }})',
                  "movewindowpixel", f"exact {target_x} {target_y},{window}")
    return 0

if __name__ == "__main__":
    sys.exit(main())