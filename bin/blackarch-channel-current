#!/bin/bash

# blackarch:summary=Print the active Blackarch package channel

set -euo pipefail

# Dev is a linked source checkout: BLACKARCH_PATH points somewhere other than
# the package-backed install at /usr/share/blackarch. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $BLACKARCH_PATH != "/usr/share/blackarch" ]]; then
  echo dev
  exit 0
fi

# blackarch-dev / blackarch-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. blackarch / blackarch-settings come
# from either the stable or rc mirror, distinguished by blackarch-version-channel
# (which reports the mirror as its first token).
if pacman -Q blackarch-dev blackarch-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q blackarch blackarch-settings >/dev/null 2>&1; then
  channel=$(blackarch-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
