#!/usr/bin/env python3
import os, sys
sys.path.insert(0, "/opt/blackarch")
try:
    from blackarch_modules.blackarch_clipboard_open import main
except Exception:
    main = None
if main is not None:
    try:
        sys.exit(main(sys.argv[1:]))
    except TypeError:
        try:
            sys.exit(main())
        except Exception as e:
            print(e, file=sys.stderr); sys.exit(1)
else:
    print("module not found", file=sys.stderr); sys.exit(1)
