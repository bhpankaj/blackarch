#!/usr/bin/env bash
#   ____ _ _       _     _     _
#  / ___| (_)_ __ | |__ (_)___| |_
# | |   | | | '_ \| '_ \| / __| __|
# | |___| | | |_) | | | | \__ \ |_
#  \____|_|_| .__/|_| |_|_|___/\__|
#           |_|
#

# -----------------------------------------------------
# Load Launcher
# -----------------------------------------------------
case $1 in
d)
  cliphist list | wofi -dmenu -replace | cliphist delete
  ;;
w)
  cliphist wipe
  ;;
*)
  cliphist list | wofi -dmenu -replace | cliphist decode | wl-copy
  ;;
esac
