#!/bin/bash

# blackarch:summary=Install Emacs with Blackarch theme and font integration via the blackarch-emacs AUR package

echo "Installing Emacs..."
blackarch-pkg-aur-add blackarch-emacs && blackarch-install-emacs

# emacsclient opens a frame on the running daemon, not a second Emacs
setsid uwsm-app -- gtk-launch emacsclient >/dev/null 2>&1 &
