#!/bin/bash

# blackarch:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# blackarch:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
blackarch-pkg-add heroic-games-launcher-bin
blackarch-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
