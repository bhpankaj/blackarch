#!/bin/bash

# blackarch:summary=Install Steam and graphics drivers selected for this system
# blackarch:requires-sudo=true

set -e

echo "Installing Steam..."
blackarch-pkg-add steam
blackarch-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
