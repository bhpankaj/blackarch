#!/bin/bash

# blackarch:summary=Finalize Blackarch user setup (runtime tweaks /etc/skel can't do)
# blackarch:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: blackarch finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and blackarch-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/blackarch/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run blackarch-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/blackarch"
mkdir -p "$state_dir"

if blackarch-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete (rerun with --force to refresh)."
  exit 0
fi

export BLACKARCH_PATH="${BLACKARCH_PATH:-/usr/share/blackarch}"
export BLACKARCH_INSTALL="${BLACKARCH_INSTALL:-$BLACKARCH_PATH/install}"
export BLACKARCH_SETUP_CONTEXT="${BLACKARCH_SETUP_CONTEXT:-runtime}"
export PATH="$BLACKARCH_PATH/bin:$PATH"

if (( first_install )) && [[ $BLACKARCH_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; blackarch-provision-owner runs first-install
  # finalization too but with BLACKARCH_SETUP_CONTEXT=provision-owner already set.
  export BLACKARCH_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${BLACKARCH_INSTALL_LOG_FILE:-} && -f $BLACKARCH_INSTALL/helpers/logging.sh ]]; then
  source "$BLACKARCH_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot live in /etc/skel because BLACKARCH_PATH may
# point at a dev checkout (blackarch dev link) where the target differs.
# Loops every skill directory, so shipping a new one needs no edit here.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills ~/.hermes/skills
for skill in "$BLACKARCH_PATH"/default/agents/skills/*/; do
  skill=${skill%/}
  name=${skill##*/}
  ln -sfn "$skill" ~/.agents/skills/"$name"
  ln -sfn "$skill" ~/.claude/skills/"$name"
  ln -sfn "$skill" ~/.codex/skills/"$name"
  ln -sfn "$skill" ~/.pi/agent/skills/"$name"
  ln -sfn "$skill" ~/.hermes/skills/"$name"
  if [[ -d ~/.hermes/profiles ]]; then
    for profile in ~/.hermes/profiles/*/; do
      [[ -d $profile ]] || continue
      mkdir -p "$profile/skills"
      ln -sfn "$skill" "$profile/skills/$name"
    done
  fi
done

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$BLACKARCH_INSTALL/user/all.sh"

blackarch-refresh-applications
env -u BROWSER xdg-settings set default-web-browser chromium.desktop
xdg-mime default HEY.desktop x-scheme-handler/mailto

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$BLACKARCH_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

blackarch-done mark finalize-user
echo "User finalization complete."
