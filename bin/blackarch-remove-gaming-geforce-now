#!/bin/bash

# blackarch:summary=Remove the GeForce NOW Flatpak app and its data.
# blackarch:group=remove
# blackarch:name=gaming geforce-now

set -e

if blackarch-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
