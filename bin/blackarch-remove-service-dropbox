#!/bin/bash

# blackarch:summary=Remove Dropbox and its bar plugin.
# blackarch:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
blackarch-plugin-disable blackarch.dropbox
blackarch-pkg-drop dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo ""
echo "Dropbox has been removed."
