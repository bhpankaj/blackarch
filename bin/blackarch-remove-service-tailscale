#!/bin/bash

# blackarch:summary=Remove Tailscale and its bar plugin.
# blackarch:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now blackarch-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
blackarch-plugin-disable blackarch.tailscale
blackarch-webapp-remove "Tailscale" 2>/dev/null || true
blackarch-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
