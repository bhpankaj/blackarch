#!/bin/bash

# blackarch:summary=Log out after closing application windows
# blackarch:examples=blackarch logout | blackarch system logout
# blackarch:aliases=blackarch logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

blackarch-osd -i logout -m "Logging out" -d 5000

# Now close all windows
blackarch-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
