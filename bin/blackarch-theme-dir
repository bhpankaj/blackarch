#!/bin/bash

# blackarch:summary=Print the directory holding a theme, preferring a user-installed copy
# blackarch:args=<theme-name>
# blackarch:examples=blackarch theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: blackarch-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/blackarch/themes/$theme ]]; then
  echo "$HOME/.config/blackarch/themes/$theme"
else
  echo "$BLACKARCH_PATH/themes/$theme"
fi
