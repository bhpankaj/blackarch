#!/bin/bash

# blackarch:summary=Update the active Blackarch dev checkout

set -euo pipefail

[[ $BLACKARCH_PATH != "/usr/share/blackarch" ]] || exit 0

if ! git -C "$BLACKARCH_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: BLACKARCH_PATH is not a git checkout: $BLACKARCH_PATH" >&2
  exit 1
fi

upstream=$(git -C "$BLACKARCH_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Blackarch dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Blackarch dev checkout\e[0m"
git -C "$BLACKARCH_PATH" pull --ff-only
