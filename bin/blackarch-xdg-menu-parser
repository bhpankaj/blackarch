#!/usr/bin/env python3
"""XDG menu parser for the Quickshell XDG launcher widget.

Evaluates the freedesktop menu definitions against the installed desktop
entries (via blackarch_modules.blackarch_xdg_menu_generator) and prints the
flat JSON model AppMenu.qml renders: one entry per top-level menu with its
application rows.

Usage: blackarch-xdg-menu-parser [menu-file ...]
"""

import json
import os
import sys

sys.path.insert(0, os.environ.get("BLACKARCH_PATH", "/opt/blackarch"))

from blackarch_modules.blackarch_xdg_menu_generator import generate


def main(argv: list[str]) -> int:
    menus = [path for path in argv if os.path.isfile(path)] or None
    data = generate(menus=menus)

    groups: dict[str, list[dict]] = {}
    for key, value in data.items():
        if value.get("kind") != "app" or not value.get("action"):
            continue
        top = key.split(".", 1)[0]
        groups.setdefault(top, []).append({
            "name": value.get("label", key),
            "exec": value["action"],
        })

    out = []
    for top, items in groups.items():
        label = data.get(top, {}).get("label", top)
        out.append({"category": label, "items": items})

    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
