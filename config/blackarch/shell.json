{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "blackarch.clock",
    "layout": {
      "left": [
        {
          "id": "blackarch.menu"
        },
        {
          "id": "blackarch.workspaces"
        }
      ],
      "center": [
        {
          "id": "blackarch.indicators"
        },
        {
          "id": "blackarch.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "blackarch.keyboard-layout"
        },
        {
          "id": "blackarch.weather"
        },
        {
          "id": "blackarch.system-update"
        }
      ],
      "right": [
        {
          "id": "blackarch.tray"
        },
        {
          "id": "blackarch.agents"
        },
        {
          "id": "blackarch.bluetooth"
        },
        {
          "id": "blackarch.network"
        },
        {
          "id": "blackarch.audio"
        },
        {
          "id": "blackarch.monitor"
        },
        {
          "id": "blackarch.power"
        }
      ]
    }
  },
  "plugins": []
}
