  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(blackarch-theme-switcher); [[ -n $theme ]] && blackarch-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(blackarch-theme-bg-switcher); [[ -n $background ]] && blackarch-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(blackarch-plymouth-switcher); if [[ $unlock == default ]]; then blackarch-launch-floating-terminal-with-presentation blackarch-plymouth-reset; elif [[ -n $unlock ]]; then blackarch-launch-floating-terminal-with-presentation \"blackarch-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
