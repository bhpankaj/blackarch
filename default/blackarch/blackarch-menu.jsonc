  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"blackarch-cmd-present sublime_text","checked":"[[ \"$(blackarch-default-editor)\" == \"sublime_text\" ]]","action":"blackarch-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"blackarch-cmd-present helix","checked":"[[ \"$(blackarch-default-editor)\" == \"helix\" ]]","action":"blackarch-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"blackarch-cmd-present vim","checked":"[[ \"$(blackarch-default-editor)\" == \"vim\" ]]","action":"blackarch-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"blackarch-cmd-present emacs","checked":"[[ \"$(blackarch-default-editor)\" == \"emacs\" ]]","action":"blackarch-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"blackarch-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"blackarch-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"blackarch-launch-floating-terminal-with-presentation 'blackarch-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"blackarch-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/blackarch/plugins/*/manifest.json\"","action":"blackarch-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"blackarch-hw-fingerprint","action":"blackarch-launch-floating-terminal-with-presentation blackarch-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"blackarch-launch-floating-terminal-with-presentation blackarch-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"blackarch-launch-floating-terminal-with-presentation blackarch-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"blackarch-launch-floating-terminal-with-presentation blackarch-sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"blackarch-sudo-docker --configured","action":"blackarch-launch-floating-terminal-with-presentation blackarch-setup-security-sudoless-docker"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"blackarch-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"blackarch-launch-config-editor ~/.config/hypr/hyprsunset.conf && blackarch-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"blackarch-launch-config-editor ~/.XCompose && blackarch-restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","action":"blackarch-launch-floating-terminal-with-presentation blackarch-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Reset Computer","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"blackarch-launch-floating-terminal-with-presentation blackarch-system-factory-reset"},

  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.blackarch.terminal blackarch-pkg-install"},
  "install.aur": {"icon":"󰣇","label":"AUR","action":"xdg-terminal-exec --app-id=org.blackarch.terminal blackarch-pkg-aur-install"},
