[Unit]
Description=Lock Blackarch before suspend
# The monitor calls into the running Blackarch shell. Wait until UWSM has imported
# BLACKARCH_PATH and WAYLAND_DISPLAY, but keep the default target ordering so the
# monitor starts before graphical-session.target is reached.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=BLACKARCH_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/blackarch-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
