+	/*
+	 * Grace period (seconds) to keep the pipeline warm after the last
+	 * client disconnects. libcamera's simple IPA AGC has no startup-frame
+	 * skip: every pipeline start replays the auto-exposure ramp
+	 * (measured 16 -> 43 -> 66 -> 71 luma over ~5 frames), which is the
+	 * visible "light flicker" on connect. Keeping one pipeline alive
+	 * across a brief disconnect avoids paying that ramp again for app
+	 * restarts, browser tab refreshes and mute/unmute cycles, while still
+	 * letting the camera fall idle (LED off, ~0% CPU) when genuinely
+	 * unused. 0 disables the grace period (stop as soon as clients leave).
+	 */
+	int grace_seconds = 30;
+	{
+		const char *gs = getenv("RELAY_GRACE_SECONDS");
+		if (gs && *gs) {
+			int v = atoi(gs);
+			if (v >= 0 && v <= 3600)
+				grace_seconds = v;
+		}
+	}
+
+	/*
+	 * Warmup hold: number of leading pipeline frames to swallow and
+	 * replace with black before showing real picture. libcamera's simple
+	 * IPA AGC has no startup-frame skip, so the first frames of every
+	 * cold pipeline start are under-exposed and brighten over ~5-15
+	 * frames (measured 16 -> 43 -> 66 -> 71 luma). A client that
+	 * connects during that window sees a visible flash. Holding black
+	 * through the ramp means the first real frame a client ever sees is
+	 * already settled. Costs warmup_frames/30 s of extra black on a cold
+	 * start only — a warm reconnect (within the grace period) skips it
+	 * entirely. 0 disables the hold.
+	 */
+	int warmup_frames = 15;
+	{
+		const char *wf = getenv("RELAY_WARMUP_FRAMES");
+		if (wf && *wf) {
+			int v = atoi(wf);
+			if (v >= 0 && v <= 600)
+				warmup_frames = v;
+		}
+	}
