#!/bin/bash

set -e

# Blackarch ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(blackarch-default-agent) ]] && blackarch-done ensure agent-setup-invitation; then
  blackarch-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Blackarch." \
    --exec blackarch menu summon setup.default.agent
fi
